# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DATABASE_URL=sqlite:///./data/ai_daily_brief.db
APP_WORKSPACE_DIR=./workspace
APP_LOG_LEVEL=INFO

# OpenAI-compatible model endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Agent execution budgets (implemented on Day 1)
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_RUN_TIMEOUT_SECONDS=180
TOOL_TIMEOUT_SECONDS=15

# Delivery. When SMTP is disabled, messages go to a local development outbox.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

